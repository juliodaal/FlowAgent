# =============================================================================
# FlowAgent — environment template
# Copy this file to `.env` and fill in real values. NEVER commit `.env`.
# =============================================================================

# --- OpenAI ------------------------------------------------------------------
# Get a key at https://platform.openai.com/api-keys
OPENAI_API_KEY=your-openai-api-key-here
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# --- Supabase ----------------------------------------------------------------
# Create a project at https://supabase.com (free tier). From Project Settings:
#   - URL: Settings > API > Project URL
#   - Service role key: Settings > API > Project API Keys > service_role
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
SUPABASE_ANON_KEY=your-anon-key-here

# --- Gmail (for the email-reading tool) --------------------------------------
# Use a Gmail App Password (https://myaccount.google.com/apppasswords).
# 2FA must be enabled on the account.
GMAIL_ADDRESS=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-char-app-password

# --- Notion ------------------------------------------------------------------
# Create an integration at https://www.notion.so/profile/integrations
# Then share the target database with that integration.
NOTION_API_KEY=your-notion-integration-secret
NOTION_TASKS_DATABASE_ID=your-target-database-id

# --- Web search (optional) ---------------------------------------------------
# Leave empty to use DuckDuckGo (no key required, default).
# Set to use Tavily (https://tavily.com — free tier 1000 req/month).
TAVILY_API_KEY=

# --- FlowAgent API -----------------------------------------------------------
# Token clients must send as `Authorization: Bearer <token>` to the backend.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
FLOWAGENT_API_TOKEN=replace-with-random-token

# --- n8n ---------------------------------------------------------------------
# Shared secret used to sign and verify webhooks between n8n and the agent.
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_WEBHOOK_SECRET=replace-with-random-secret
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=replace-with-strong-password

# --- Frontend ----------------------------------------------------------------
# Base URL where the Next.js app reaches the Python backend.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
